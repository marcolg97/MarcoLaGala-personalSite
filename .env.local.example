# GitHub fine-grained token with read-only "Contents" access to the content repo
GITHUB_TOKEN=

# Private GitHub repo with MDX posts in posts/ (format: owner/repo — no .git suffix)
PRIVATE_CONTENT_REPO=owner/repo

# Local writing: path to a checkout of the content repo.
# When set, posts are read from disk (drafts included) instead of GitHub.
# LOCAL_CONTENT_DIR=../myblogpost

# Secret of the GitHub webhook that calls /api/revalidate on push
REVALIDATE_SECRET=

# Public site URL for canonical URLs, sitemap and previews (no trailing slash).
# On Vercel it falls back to the production domain if unset.
NEXT_PUBLIC_SITE_URL=https://marcolagala.com

# Show blog pages and navigation (set to "true" to enable)
NEXT_PUBLIC_BLOG_ENABLED=false
